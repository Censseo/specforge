+# Agent metadata: folder|display name|context file|context glob|project dir env
+# Mirrors AGENT_CONFIG in src/forge_cli/__init__.py - keep the two in sync.
+agent_meta() {
+  case $1 in
+    copilot) echo '.github|GitHub Copilot|copilot-instructions.md|**/*copilot-instructions.md|$PWD' ;;
+    claude) echo '.claude|Claude Code|CLAUDE.md|**/*CLAUDE.md|$CLAUDE_PROJECT_DIR' ;;
+    gemini) echo '.gemini|Gemini CLI|GEMINI.md|**/*GEMINI.md|$PWD' ;;
+    cursor-agent) echo '.cursor|Cursor|specify-rules.mdc|**/*specify-rules.mdc|$PWD' ;;
+    qwen) echo '.qwen|Qwen Code|QWEN.md|**/*QWEN.md|$PWD' ;;
+    opencode) echo '.opencode|opencode|AGENTS.md|**/*AGENTS.md|$PWD' ;;
+    codex) echo '.codex|Codex CLI|AGENTS.md|**/*AGENTS.md|$PWD' ;;
+    windsurf) echo '.windsurf|Windsurf|specify-rules.md|**/*specify-rules.md|$PWD' ;;
+    kilocode) echo '.kilocode|Kilo Code|specify-rules.md|**/*specify-rules.md|$PWD' ;;
+    auggie) echo '.augment|Auggie CLI|specify-rules.md|**/*specify-rules.md|$PWD' ;;
+    codebuddy) echo '.codebuddy|CodeBuddy|CODEBUDDY.md|**/*CODEBUDDY.md|$PWD' ;;
+    qoder) echo '.qoder|Qoder CLI|QODER.md|**/*QODER.md|$PWD' ;;
+    roo) echo '.roo|Roo Code|specify-rules.md|**/*specify-rules.md|$PWD' ;;
+    q) echo '.amazonq|Amazon Q Developer CLI|AGENTS.md|**/*AGENTS.md|$PWD' ;;
+    amp) echo '.agents|Amp|AGENTS.md|**/*AGENTS.md|$PWD' ;;
+    shai) echo '.shai|SHAI|SHAI.md|**/*SHAI.md|$PWD' ;;
+    bob) echo '.bob|IBM Bob|AGENTS.md|**/*AGENTS.md|$PWD' ;;
+    *) echo ".$1|$1|AGENTS.md|**/*AGENTS.md|\$PWD" ;;
+  esac
+}
+
+# Replace the agent placeholders in template content read from stdin.
+# __AGENT_DIR__ contains __AGENT__, so the longer tokens are substituted first.
+substitute_agent_placeholders() {
+  local agent=$1
+  local meta folder name ctx_file ctx_glob proj_env
+  meta=$(agent_meta "$agent")
+  IFS='|' read -r folder name ctx_file ctx_glob proj_env <<< "$meta"
+  sed -e "s|__AGENT_DIR__|${folder}|g" \
+      -e "s|__AGENT_NAME__|${name}|g" \
+      -e "s|__AGENT_CONTEXT_FILE__|${ctx_file}|g" \
+      -e "s|__AGENT_CONTEXT_GLOB__|${ctx_glob}|g" \
+      -e "s|__AGENT_PROJECT_DIR_ENV__|${proj_env}|g" \
+      -e "s|__AGENT__|${agent}|g"
+}
+
+# Install the bundled SpecForge skills into the agent's skills directory,
+# applying the same {SCRIPT} and __AGENT_*__ substitutions as the commands.
+generate_skills() {
+  local agent=$1 script_variant=$2 output_dir=$3
+  [[ -d templates/skills ]] || return 0
+  mkdir -p "$output_dir"
+
+  local source_file rel dest script_command
+  while IFS= read -r -d '' source_file; do
+    rel=${source_file#templates/skills/}
+    dest="$output_dir/$rel"
+    mkdir -p "$(dirname "$dest")"
+
+    if [[ $source_file == *.md ]]; then
+      script_command=$(tr -d '\r' < "$source_file" | awk -v sv="$script_variant" \
+        '$0 ~ "^[[:space:]]*"sv":[[:space:]]*" { sub("^[[:space:]]*"sv":[[:space:]]*", ""); print; exit }')
+      tr -d '\r' < "$source_file" \
+        | sed "s|{SCRIPT}|${script_command}|g" \
+        | substitute_agent_placeholders "$agent" \
+        | rewrite_paths > "$dest"
+    else
+      cp "$source_file" "$dest"
+    fi
+  done < <(find templates/skills -type f -print0)
+}
+
 generate_commands() {
   local agent=$1 ext=$2 arg_format=$3 output_dir=$4 script_variant=$5
   mkdir -p "$output_dir"
@@ -87,7 +153,7 @@ generate_commands() {
